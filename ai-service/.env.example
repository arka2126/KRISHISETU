# Port the FastAPI service listens on (used by uvicorn command / docs only)
AI_SERVICE_PORT=8001

# Origin of the Node.js backend, for CORS
NODE_BACKEND_URL=http://localhost:5000

# Where trained model files (.joblib) and metadata (.json) are written/read
MODEL_DIR=./saved_models

# --- Real external data sources (OPTIONAL) ---
# Leave these unset to use the built-in MOCK_DATA provider (deterministic synthetic
# market history, clearly labeled "source": "MOCK_DATA" in every response).
#
# Agmarknet / e-NAM does not currently offer a simple public per-commodity REST API;
# integrating it requires state APMC registration. Once you have access:
#   AGMARKNET_API_KEY=your_key_here
#   AGMARKNET_BASE_URL=https://your-agmarknet-endpoint
#
# Any weather provider (e.g. OpenWeatherMap) can be wired into app/data/adapters.py's
# OpenWeatherAdapter once you have a key:
#   OPENWEATHER_API_KEY=your_key_here
